# VibeResearch 后端可选配置。
# 本地自托管：全部留空即可（开箱开放）。公网部署：务必设置下面两项。
# 用法：复制为 .env，或直接 export 这些环境变量后再起服务。

# ── 安全（公网部署必设） ─────────────────────────────────────────────
# CORS 白名单，逗号分隔。默认 "*"（放开，适合本地）。公网收紧成你的前端域名：
#   VR_ALLOW_ORIGINS=https://your-frontend-host
VR_ALLOW_ORIGINS=*

# 鉴权 key。一旦设置，所有 /api/*（除 /api/health）都需带 Authorization: Bearer <key>。
# 本地留空=开放；公网部署务必设一个强随机值（否则别人能读你的持仓、调你的后端）：
#   VR_API_KEY=$(openssl rand -hex 32)
VR_API_KEY=

# ── 本机数据目录 ────────────────────────────────────────────────────
# 持仓 / 资讯雷达缓存 / 回测库存 / 标的池 / 复盘归档 的根目录。默认 ~/.vibe-research
# （仓库外，覆盖安装不丢）。旧版 backend/.cache/ 里的持仓和雷达缓存会自动复制过来。
# VR_DATA_DIR=

# ── 数据源（可选） ───────────────────────────────────────────────────
# 行情/研报/公告/资金面等零 key 即用；仅产业链「问财刷新」选股需要 key：
# IWENCAI_API_KEY=
# IWENCAI_BASE_URL=https://openapi.iwencai.com

# SEC EDGAR (美股申报列表 / 全市场当日流)。官方要求 User-Agent 含真实联系方式，
# 否则返回 Undeclared Automated Tool。格式: "Name email@domain.com"
# VR_SEC_CONTACT=VibeResearch you@example.com

# 代理：默认不用管。东财等国内数据源**默认直连**（自动绕开你的科学上网/Clash 代理，
# 因为国内财经站走翻墙代理反而会连不上，如 push2.eastmoney.com）。
# 仅当你的机器「只能靠代理才能出网」时，才设为 1 强制走系统代理：
# VR_DATA_PROXY=1

# OpenVlab 网页 MQTT（默认开）：订 optionflow / ctamap / dataview；驾驶舱 2s 读本机内存叠 REST，不写钥匙。
# VR_OVLAB_MQTT=0                 # 关闭
# VR_OVLAB_MQTT_SOURCES=optionflow,ctamap,dataview
# VR_OVLAB_MQTT_TIER=guest

# 复盘缓存预热（默认开）：后台定时拉每日复盘常用接口，前端首屏更快。
# VR_REVIEW_WARMUP=0              # 关闭
# 复盘上下文按日落 VR_DATA_DIR/review-archive/YYYY-MM-DD.txt（预热 / 问 AI / 邮件共用打包口）。
# VR_REVIEW_ARCHIVE=0             # 关闭
# VR_REVIEW_WARMUP_OPEN_SEC=90    # 交易时段间隔（秒）
# VR_REVIEW_WARMUP_LUNCH_SEC=300  # 午休
# VR_REVIEW_WARMUP_CLOSED_SEC=900 # 非交易时段

# 期货 CTP 只读（「我的持仓 → 期货账户」）。也可写 ~/.vibe-research/ctp.json
# CTP_HOST=
# CTP_BROKER=
# CTP_USER=
# CTP_PASSWORD=
# CTP_APPID=
# CTP_AUTHCODE=

# AI 观察页（可选）：
# OPENROUTER_API_KEY=          # 公有云 Token 日榜（无 key 则只读本地缓存）
# VR_OPENROUTER_API_KEY=       # 同上，别名
# ARTIFICIAL_ANALYSIS_API_KEY= # 大模型价格表 / 智能指数（无 key 则空表）
#
# 对话 AI（网页「问 AI」）：无需在此配置。用户在网页「接入 AI」页填自己的 key（存本地浏览器），
#     或用订阅接入调本机已登录的 CLI（Claude Code / Codex / Qwen / Gemini / DeepSeek）。
#
# 定时复盘邮件（可选）：收盘后后端自己跑一轮 AI 总结并 SMTP 发到你的邮箱。
# 开关 / 时间 / 收件人也可在网页「接入 AI」里改, 立刻生效, 不必重启。
# 网页里的 key 定时任务读不到，必须在这里再配一份模型 + SMTP。不配则不发。
# VR_REVIEW_MAIL=1                 # 仅当网页还没保存过开关时作为默认
# VR_REVIEW_MAIL_AT=16:10          # 北京时间, 仅 A 股交易日, 每天最多一封
# VR_REVIEW_MAIL_TO=you@qq.com     # 不填则用 NOTIFY_EMAIL
# VR_REVIEW_LLM_BASE_URL=https://api.deepseek.com
# VR_REVIEW_LLM_API_KEY=
# VR_REVIEW_LLM_MODEL=deepseek-chat
# # 或订阅 CLI（后端必须跑在已登录的那台机器上）:
# # VR_REVIEW_LLM_PROVIDER=cli-claude
# # VR_REVIEW_LLM_MODEL=cli-claude
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=you@qq.com
# SMTP_PASS=                     # QQ 邮箱授权码, 不是登录密码
# SMTP_FROM=                     # 默认同 SMTP_USER
# SMTP_FROM_NAME=Vibe-Research   # 发件人显示名
# NOTIFY_EMAIL=you@qq.com        # 部署成功通知与复盘邮件可共用

# Fino 机构观点 (可选): uni_id -> 公司名称 映射表路径 (json/csv/xlsx).
# 不设则依次找 backend/data/fino_uni_id_map.json、uni_id_ v1.1_20260119.xlsx.
# 无映射时 detail.source 回退为 机构#<uni_id>.
# FINO_UNI_ID_MAP=
# FINO_APPKEY=
# FINO_APPSECRET=
